---
import { withBase } from '../lib/paths';
import '@fontsource/coustard/400.css';
import '@fontsource/pixelify-sans/400.css';
import '@fontsource/pixelify-sans/600.css';
import '../styles/global.css';
import Avatar from '../components/Avatar.astro';
import { site, text } from '../config';

interface Props {
  title?: string;
  description?: string;
  section?: 'home' | 'blog' | 'things' | 'about';
  /** The home page shows the full profile card; inner pages use a compact one. */
  profile?: 'full' | 'compact';
  articleDate?: Date;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  section,
  profile = 'compact',
  articleDate,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase('/social.png'), Astro.site);
const tabs = [
  { label: text.navHome, href: withBase('/'), key: 'home' },
  { label: text.navBlog, href: withBase('/blog/'), key: 'blog' },
  { label: text.navThings, href: withBase('/things/'), key: 'things' },
  { label: text.navAbout, href: withBase('/about/'), key: 'about' },
];
const NameTag = profile === 'full' ? 'h1' : 'p';
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#5476b4" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('/rss.xml')} />
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[`profile-${profile}`]}>
    <a class="skip" href="#content">{text.skipLink}</a>
    <div class="sky" aria-hidden="true"></div>
    <div class="page">
      <header class="profile-card">
        <img class="card-cat" src={withBase('/art/cat-sleep.png')} alt="" width="92" height="92" decoding="async" />
        <a class="avatar-link" href={withBase('/')} aria-label={`${site.name}, home`}>
          <Avatar size={profile === 'full' ? 208 : 88} eager />
        </a>
        <div class="identity">
          <NameTag class="name"><a href={withBase('/')}>{site.name}</a></NameTag>
          {profile === 'full' && site.taglines.length > 0 && (
            <p class="taglines">
              {site.taglines.map((line, index) => (
                <>{index > 0 && <span class="divider" aria-hidden="true">✦</span>}<span>{line}</span></>
              ))}
            </p>
          )}
          <nav class="tabs" aria-label="Site">
            {tabs.map(tab => (
              <a href={tab.href} aria-current={section === tab.key ? 'page' : undefined}>{tab.label}</a>
            ))}
          </nav>
        </div>
      </header>

      <main id="content" class="paper" tabindex="-1">
        <slot />
        <img class="paper-cat" src={withBase('/art/cat-jump.png')} alt="" width="96" height="96" loading="lazy" decoding="async" />
      </main>

      <footer class="footer">
        <nav class="footer-links" aria-label="Elsewhere">
          {site.links.map(link => {
            const external = /^https?:/.test(link.url);
            return (
              <a href={withBase(link.url)} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{link.label}</a>
            );
          })}
          <a href={withBase('/rss.xml')}>{text.rssLink}</a>
        </nav>
        <p>© {year} {site.name}</p>
      </footer>
    </div>
  </body>
</html>
