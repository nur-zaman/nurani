---
import { withBase } from '../lib/paths';
import SiteLayout from '../layouts/SiteLayout.astro';
import { text } from '../config';
---

<SiteLayout title={text.notFoundTitle} noindex>
  <div class="empty not-found">
    <img src={withBase('/art/cat-sleep.png')} alt="" width="180" height="180" />
    <h1>{text.notFoundTitle}</h1>
    <p>{text.notFoundText}</p>
    <a class="more" href={withBase('/')}>{text.notFoundLink}</a>
  </div>
</SiteLayout>
