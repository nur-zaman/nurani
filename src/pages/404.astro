---
import { withBase } from '../lib/paths';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found" noindex>
  <div class="empty not-found">
    <img src={withBase('/art/cat-sleep.png')} alt="" width="180" height="180" />
    <h1>Shh, nothing here</h1>
    <p>This page doesn't exist, or it wandered off. The cat is not going to look for it.</p>
    <a class="more" href={withBase('/')}>← Go home</a>
  </div>
</SiteLayout>
